# ──────────────────────────────────────────────────────────────
#  General Settings & Variables
# ──────────────────────────────────────────────────────────────

# Modifier Keys
set $mod Mod4
set $alt Mod1

# Application Variables
set $term rio
set $browser brave
set $fileman thunar
set $fileman2 pcmanfm-qt
set $editor code
set $emacs emacs
set $telegram telegram-desktop
set $obsidian obsidian
set $lock_script $HOME/.config/i3/scripts/lock

# Catppuccin Mocha Colors
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

# ──────────────────────────────────────────────────────────────
# Appearance Settings
# ──────────────────────────────────────────────────────────────

# Font Configuration: Clean, modern, and supports icons (Nerd Font recommended)
font pango:Hack 12

# Window Appearance
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
title_align center

# Gaps Configuration
smart_gaps on
smart_borders on
gaps inner 8
gaps outer 3

# Window Colors
# class                border     backgr.    text       indicator child_border
client.focused         $mauve     $surface0  $text      $rosewater $mauve
client.focused_inactive $surface1  $surface0  $subtext1  $rosewater $surface1
client.unfocused       $surface1  $base      $subtext0  $rosewater $surface1
client.urgent          $peach     $surface0  $crust     $peach     $peach
client.placeholder     $surface1  $base      $subtext0  $surface1  $surface1
# client.background $base # Removed - minimal effect in tiling WMs

# ──────────────────────────────────────────────────────────────
# Autostart Applications (Run on i3 startup)
# ──────────────────────────────────────────────────────────────

# System Essentials
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 # Policy Kit
exec --no-startup-id nm-applet --indicator                                     # Network Manager
exec --no-startup-id numlockx on                                                # Enable Numlock
exec --no-startup-id autorandr --change                                         # Multi-Monitor Layouts
exec --no-startup-id sh -c "xss-lock --transfer-sleep-lock $lock_script"

# Compositing and Clipboard
exec --no-startup-id picom --config ~/.config/picom/picom.conf                  # Compositor
exec_always --no-startup-id clipcatd                                            # Clipboard Daemon

# Wallpaper
exec --no-startup-id feh --bg-fill --randomize --no-xinerama "/home/usb/Pictures/Desktop Wallpapers/"

# Keyboard Layout (exec_always is better for this)
exec_always --no-startup-id "setxkbmap -model pc105+inet -layout us,ara -variant qwerty -option 'grp:win_space_toggle'"

# Status Bar
exec_always --no-startup-id ~/.config/polybar/cuts/launch.sh



# ──────────────────────────────────────────────────────────────
# Keybindings: Applications
# ──────────────────────────────────────────────────────────────

# Base applications
bindsym $mod+Return exec $term
bindsym $mod+b      exec $browser
bindsym $mod+F1     exec $fileman
bindsym $mod+F2     exec $emacs
bindsym $mod+F3     exec $obsidian
bindsym $mod+F4     exec $fileman2
bindsym $mod+F12    exec $editor
bindsym $mod+q kill

# Communication apps
bindsym $mod+Shift+t exec $telegram

# Screenshot & Utilities
bindsym $mod+Print   exec flameshot full -p ~/Pictures/Screenshots
bindsym $mod+z       exec flameshot gui
bindsym $mod+Shift+z exec flameshot screen -p ~/Pictures/Screenshots
bindsym $mod+Ctrl+x  exec xkill

# Clipboard History
set $launcher-clipboard-insert clipcat-menu insert
set $launcher-clipboard-remove clipcat-menu remove
bindsym $mod+p exec $launcher-clipboard-insert
bindsym $mod+o exec $launcher-clipboard-remove

# ──────────────────────────────────────────────────────────────
# Launchers
# ──────────────────────────────────────────────────────────────
# dmenu Application Launcher (No change)
bindsym $mod+d exec --no-startup-id dmenu_run \
    -i \
    -p '  Run → ' \
    -l 5 \
    -fn 'JetBrains Mono:size=14:bold' \
    -nb "$base" \
    -nf "$text" \
    -sb "$mauve" \
    -sf "$base"

# Rofi Application launcher
bindsym ctrl+space exec rofi -show drun

# Window switcher
bindsym $mod+Tab exec rofi -show window

# Power menu
bindsym $mod+Escape exec --no-startup-id ~/.config/i3/scripts/system-menu.sh

# ──────────────────────────────────────────────────────────────
# Keybindings: Window Management
# ──────────────────────────────────────────────────────────────

bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Move windows
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Split orientation
# Vertical Split
bindsym $mod+v split v
# Horizontal Split
bindsym $mod+h split h

# Layouts
bindsym $mod+f fullscreen toggle
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+s layout stacking
bindsym $mod+t split toggle

# Floating
bindsym $alt+f floating toggle
bindsym $alt+space focus mode_toggle
floating_modifier $mod

# Focus parent/child container
bindsym $mod+a focus parent

# ──────────────────────────────────────────────────────────────
# Workspaces
# ──────────────────────────────────────────────────────────────

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Move focused window to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# Switch to next/previous workspace
bindsym $mod+Ctrl+Right workspace next
bindsym $mod+Ctrl+Left workspace prev

# Move container to next/previous workspace
bindsym $mod+Ctrl+Shift+Right move container to workspace next
bindsym $mod+Ctrl+Shift+Left move container to workspace prev

# Assign specific applications to workspaces (using the new names)
assign [class="^Brave-browser$"] $ws2
assign [class="^Code$"] $ws3
assign [class="^Emacs$"] $ws3
assign [class="^Telegram-desktop$"] $ws5
assign [class="^Obsidian$"] $ws4

# ──────────────────────────────────────────────────────────────
# Floating Windows Rules & Assignments
# ──────────────────────────────────────────────────────────────

# Consolidated generic rules
for_window [window_role="dialog|pop-up"] floating enable, border pixel 1
for_window [window_type="dialog|menu|utility"] floating enable, border pixel 1

# Specific application rules (Alphabetized for better management)
for_window [title="alsamixer"] floating enable, border pixel 1
for_window [class="(?i)GParted"] floating enable, border pixel 2
for_window [class="Gimp"] floating enable, border pixel 2
for_window [class="Lxappearance|Nitrogen|qt5ct|Qtconfig-qt4|Lightdm-settings|Blueman-manager"] floating enable, sticky enable, border pixel 2
for_window [class="Pavucontrol"] floating enable, border pixel 2
for_window [class="Steam"] floating enable, border pixel 2
for_window [class="zoom"] floating enable, border pixel 2

# Always show window icons in titles
for_window [class=".*"] title_window_icon on

# ──────────────────────────────────────────────────────────────
# Media and Volume Control
# ──────────────────────────────────────────────────────────────

# Volume Control
bindsym XF86AudioMute exec --no-startup-id pamixer -t && ~/.config/i3/scripts/volume-notify.sh mute
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5 && ~/.config/i3/scripts/volume-notify.sh down
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5 && ~/.config/i3/scripts/volume-notify.sh up
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Brightness Control
bindsym XF86MonBrightnessUp exec light -A 5 && ~/.config/i3/scripts/brightness-notify.sh up
bindsym XF86MonBrightnessDown exec light -U 5 && ~/.config/i3/scripts/brightness-notify.sh down

# NOTE: The above volume/brightness commands assume you create simple scripts
# like `volume-notify.sh` to handle the dunst notifications, making the i3 config cleaner.
# E.g., for `volume-notify.sh`:
# case "$1" in
#   up) pamixer -i 5; PERCENT=$(pamixer --get-volume); TAG="volume";;
#   down) pamixer -d 5; PERCENT=$(pamixer --get-volume); TAG="volume";;
#   mute) pamixer -t; PERCENT=$(pamixer --get-volume); TAG="volume";;
# esac
# dunstify -a "Volume" -u low -h string:x-dunst-stack-tag:$TAG -h int:value:$PERCENT "Vol: $PERCENT%"


# ──────────────────────────────────────────────────────────────
# System Controls
# ──────────────────────────────────────────────────────────────
# Lock screen
bindsym $mod+Ctrl+l exec $lock_script

# ──────────────────────────────────────────────────────────────
# Advanced Window Management
# ──────────────────────────────────────────────────────────────

bindsym $mod+Shift+w reload
bindsym $mod+Shift+r restart

mode "resize" {
    # Resize using hjkl (step: 10 pixels or 10 percentage points)
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
 
    # Resize using arrow keys (optional, matches above)
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # Exit mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Focus Follows Mouse
focus_follows_mouse yes

# Mouse warping (disabled for more precise control)
mouse_warping none

# ──────────────────────────────────────────────────────────────
# End of Config
# ──────────────────────────────────────────────────────────────
