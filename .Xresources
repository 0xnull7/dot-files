! -----------------------------------------------------------------------------
! .Xresources v2.0
! Author: 0xNull7
! -----------------------------------------------------------------------------

! ---[ 1. DEFINITIONS ]--------------------------------------------------------
! Define constants here for easy switching.
#define FONT_MONO       xft:FiraCode Nerd Font Mono:size=16:antialias=true:autohint=true
#define FONT_BOLD       xft:FiraCode Nerd Font Mono:bold:size=16:antialias=true:autohint=true
#define FONT_UI         xft:Sans:size=14:antialias=true:autohint=true

! Solarized Dark-ish Palette (Refined for contrast)
#define COLOR_BG        #1e1e1e
#define COLOR_FG        #d4d4d4
#define COLOR_CURSOR    #ffffff

! ---[ 2. CORE TERMINAL SETTINGS ]---------------------------------------------

! Class matching: generic XTerm and specific vt100 widget
XTerm*termName:                 xterm-256color
XTerm*locale:                   true
XTerm*utf8:                     true

! Fonts
XTerm*vt100.faceName:           FONT_MONO
XTerm*vt100.boldFont:           FONT_BOLD
XTerm*XftFont:                  FONT_UI

! Geometry & Buffers
XTerm*vt100.geometry:           110x35
XTerm*saveLines:                16384

! Scrollbar (Hidden, but functional via Shift+PgUp/PgDn)
XTerm*scrollBar:                false
XTerm*scrollTtyOutput:          false
XTerm*scrollKey:                true

! Cursor
XTerm*cursorBlink:              true
XTerm*cursorColor:              COLOR_CURSOR
XTerm*cursorShape:              bar

! ---[ 3. BEHAVIOR & COMPATIBILITY ]-------------------------------------------

! CRITICAL: Allow TUI apps (vim, tmux, htop) to use the mouse.
! Hold 'Shift' to override application mouse control and select text natively.
XTerm*allowMouseOps:            true

! Alt/Meta key behavior (Fixes Alt+Key bindings in bash/vim)
XTerm*metaSendsEscape:          true
XTerm*eightBitInput:            false

! Clipboard: Selection automatically copies to Clipboard (CTRL+C style)
! rather than just Primary (Middle-click style).
XTerm*selectToClipboard:        true

! Bell (Visual only, no audio)
XTerm*visualBell:               true
XTerm*bellIsUrgent:             true
XTerm*visualBellLine:           true

! Border & Padding
XTerm*vt100.internalBorder:     12
XTerm*borderWidth:              0

! ---[ 4. THEME & COLORS ]-----------------------------------------------------

XTerm*vt100.background:         COLOR_BG
XTerm*vt100.foreground:         COLOR_FG

! Bold Text Handling
XTerm*veryBoldColors:           6
XTerm*colorBDMode:              true
XTerm*colorBD:                  #ffffff

! ANSI Colors (0-15)
! Black
XTerm*color0:                   #282a36
XTerm*color8:                   #6272a4
! Red
XTerm*color1:                   #ff5555
XTerm*color9:                   #ff6e6e
! Green
XTerm*color2:                   #50fa7b
XTerm*color10:                  #69ff94
! Yellow
XTerm*color3:                   #f1fa8c
XTerm*color11:                  #ffffa5
! Blue
XTerm*color4:                   #bd93f9
XTerm*color12:                  #d6acff
! Magenta
XTerm*color5:                   #ff79c6
XTerm*color13:                  #ff92df
! Cyan
XTerm*color6:                   #8be9fd
XTerm*color14:                  #a4ffff
! White
XTerm*color7:                   #f8f8f2
XTerm*color15:                  #ffffff

! ---[ 5. UI & MENUS (Minimalist) ]--------------------------------------------

! Match Menu background to Terminal background for seamless look
XTerm*SimpleMenu*background:    COLOR_BG
XTerm*SimpleMenu*foreground:    COLOR_FG
XTerm*SimpleMenu*borderWidth:   0

! ---[ 6. KEY BINDINGS ]-------------------------------------------------------

! Modern Copy/Paste (Ctrl+Shift+C / Ctrl+Shift+V)
! Font Zooming (Ctrl+Plus / Ctrl+Minus)
XTerm*vt100.translations: #override \n\
    Shift <Key>Insert:    insert-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V:    insert-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>C:    copy-selection(CLIPBOARD) \n\
    Ctrl <Key>Plus:       larger-vt-font() \n\
    Ctrl <Key>Minus:      smaller-vt-font() \n\
    Ctrl <Key>0:          set-vt-font(d)

! ---[ 7. XFT SETTINGS (System Wide) ]-----------------------------------------
! These apply to all X11 apps reading Xresources, not just Xterm.

Xft.dpi:                        96
Xft.antialias:                  1
Xft.hinting:                    1
Xft.hintstyle:                  hintslight
Xft.rgba:                       rgb
Xft.lcdfilter:                  lcddefault
