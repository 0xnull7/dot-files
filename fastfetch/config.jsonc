{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // "source": "~/.config/fastfetch/images/pusheen.png",
    // "type": "kitty-direct",
    // "height": 18,
    // "width": 36,
    "padding": {
      "top": 2,
      "left": 1,
    },
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "magenta",
    },
  },
  "modules": [
    {
      "type": "title",
      "format": " {1}@{2}",
      "color": {
        "user": "blue",
        "at": "white",
        "host": "blue",
      },
    },
    {
      "type": "os",
      "key": "  DISTRO",
      "keyColor": "yellow",
    },
    {
      "type": "kernel",
      "key": " │ ├",
      "keyColor": "yellow",
    },
    {
      "type": "packages",
      "key": " │ ├󰏖",
      "keyColor": "yellow",
    },
    {
      "type": "command",
      "key": " │ ├",
      "keyColor": "yellow",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "shell",
      "key": " │ └",
      "keyColor": "yellow",
    },
    "break",
    {
      "type": "wm",
      "key": "  DE/WM ",
      "keyColor": "blue",
    },
    {
      "type": "wmtheme",
      "key": " │ ├󰉼",
      "keyColor": "blue",
    },
    {
      "type": "icons",
      "key": " │ ├󰀻",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": " │ ├",
      "keyColor": "blue",
    },
    {
      "type": "terminalfont",
      "key": " │ └",
      "keyColor": "blue",
    },
    "break",
    {
      "type": "host",
      "key": " 󰌢 SYSTEM",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": " │ ├󰻠",
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "key": " │ ├󰻑",
      "format": "{2}",
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": " │ ├󰍛",
      "keyColor": "green",
    },
    {
      "type": "disk",
      "key": " │ ├",
      "keyColor": "green",
    },
    {
      "type": "uptime",
      "key": " │ └󰅐",
      "keyColor": "green",
    },
    "break",
    {
      "type": "custom",
      "format": " \u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m  \u001b[39m    \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m  \u001b[90m",
    },
    "break",
  ],
}
